<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>MultiSeat.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <RootNamespace>MultiSeat</RootNamespace>
    <AssemblyName>MultiSeat</AssemblyName>
    <Product>MultiSeat</Product>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\MultiSeat.Core\MultiSeat.Core.csproj" />
  </ItemGroup>
  <!-- interception.dll is downloaded by setup\Get-Interception.ps1 (build.ps1 does this). -->
  <ItemGroup>
    <None Include="..\..\third_party\Interception\library\x64\interception.dll"
          Condition="Exists('..\..\third_party\Interception\library\x64\interception.dll')"
          Link="interception.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
