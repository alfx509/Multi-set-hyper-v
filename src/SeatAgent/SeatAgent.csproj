<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- No window. Started in every session by the HKLM Run key; exits at once if this user is not a seat. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <RootNamespace>MultiSeat.Agent</RootNamespace>
    <ApplicationIcon>..\MultiSeat\MultiSeat.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\MultiSeat.Core\MultiSeat.Core.csproj" />
  </ItemGroup>
</Project>
